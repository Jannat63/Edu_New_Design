# ═══════════════════════════════════════════════════════════════
#  EduBD — Environment Configuration
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

APP_NAME=EduBD
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ── DATABASE ────────────────────────────────────────────────────
# setup.sh fills this in automatically with a dedicated database user
# (not root — works regardless of how PHP/MySQL are configured on your OS)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edubd
DB_USERNAME=root
DB_PASSWORD=

# ── SESSION / CACHE ────────────────────────────────────────────
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── EMAIL ───────────────────────────────────────────────────────
# Defaults to 'log' so password-reset emails are written to
# storage/logs/laravel.log instead of crashing when no real mail
# server is configured yet. Switch to 'smtp' once you fill in
# MAIL_HOST/MAIL_USERNAME/MAIL_PASSWORD below.
MAIL_MAILER=log
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@edubd.com
MAIL_FROM_NAME="EduBD"

# ── PAYMENT GATEWAYS ────────────────────────────────────────────
# (Optional — fill in when you get your credentials)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_MERCHANT_PUBLIC_KEY=
NAGAD_PG_PUBLIC_KEY=
NAGAD_BASE_URL=https://sandbox.mynagad.com

SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWD=
SSLCZ_IS_SANDBOXED=true

# ── VIDEO HOSTING (Bunny Stream) ────────────────────────────────
# (Optional — only needed for instructor video upload; without it the
# manual "Video URL" paste field in the course editor still works fine)
# Get these from a Bunny Stream Video Library, not the main account:
# dash.bunny.net → Stream → your library → API tab.
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=

# ── LIVE CLASSES (Daily.co, Phase 3 item 6) ───────────────────────
# (Optional — without it, scheduling a live class shows a clear
# "not configured" message instead of erroring)
# Get these from dash.daily.co → Developers.
DAILY_API_KEY=
DAILY_DOMAIN=

# ── AI DOUBT-SOLVING ASSISTANT (Phase 2 item 3) ──────────────────
# Get a key at https://console.anthropic.com — without it, the
# assistant returns a clear "not configured" message instead of
# erroring, the rest of the site is unaffected either way.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

